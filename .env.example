# Local Postgres from docker-compose.yml (`pnpm db:up`)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/allchat
# The public key of the lolesports persisted gateway (esports-api.lolesports.com)
LOL_API_KEY=
# lolesports tournament slugs to sync, comma-separated (e.g. worlds_2026,msi_2027)
LOL_TOURNAMENTS=worlds_2026
