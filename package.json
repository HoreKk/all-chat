    "@orpc/experimental-effect": "2.0.0-beta.43",
    "@orpc/server": "2.0.0-beta.43",
    "@orpc/tanstack-query": "2.0.0-beta.43",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "drizzle-seed": "1.0.0-rc.5-5935859",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
