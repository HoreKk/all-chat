{
  "name": "all-chat",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.ts",
    "db:seed:calendar": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.ts calendar"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.2",
